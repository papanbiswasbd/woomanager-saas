generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  
  stores    Store[]
  orders    Order[]
  customers Customer[]
  products  Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Store {
  id              Int      @id @default(autoincrement())
  url             String
  consumerKey     String
  consumerSecret  String
  webhookSecret   String?
  lastSyncedAt    DateTime @default(now())
  
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

model Order {
  id                    Int      @id
  number                String
  status                String
  date_created          DateTime
  date_modified         DateTime @default(now())
  payment_method_title  String?
  transaction_id        String?
  customer_ip_address   String?
  currency_symbol       String
  total                 String
  total_tax             String
  discount_total        String
  shipping_total        String
  customer_note         String?
  
  billing               String
  shipping              String
  line_items            String
  fee_lines             String   @default("[]")

  userId                String?
  user                  User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([date_created])
  @@index([date_modified])
}

model Customer {
  id                    Int      @id
  email                 String   
  first_name            String
  last_name             String
  role                  String?
  username              String?
  
  billing               String
  shipping              String
  
  is_paying_customer    Boolean  @default(false)
  orders_count          Int      @default(0)
  total_spent           String   @default("0")
  
  date_created          DateTime
  date_modified         DateTime @default(now())
  
  userId                String?
  user                  User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
  @@index([date_created])
  @@index([date_modified])
}

model Product {
  id                    Int      @id
  name                  String
  slug                  String
  permalink             String
  type                  String
  status                String
  featured              Boolean  @default(false)
  catalog_visibility    String
  description           String
  short_description     String
  sku                   String
  price                 String
  regular_price         String
  sale_price            String
  
  manage_stock          Boolean  @default(false)
  stock_quantity        Int?
  stock_status          String
  
  categories            String
  images                String
  attributes            String
  
  date_created          DateTime
  date_modified         DateTime @default(now())
  
  userId                String?
  user                  User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([date_created])
  @@index([date_modified])
}
